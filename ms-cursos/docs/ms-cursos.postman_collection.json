  "item": [
    {
      "name": "Login (administrador)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuarios_url}}/usuarios/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.collectionVariables.set('token', r.token);",
              "pm.test('200 y token', () => pm.expect(r.token).to.be.a('string'));"
            ]
          }
        }
      ]
    },
